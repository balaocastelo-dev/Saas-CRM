# Variáveis de Ambiente — Balão CRM WhatsApp
# Copie este arquivo para .env.local e preencha os valores reais

# =====================================================
# SUPABASE
# =====================================================
# O projeto aceita os dois formatos abaixo.
# Você pode preencher apenas um conjunto, mas manter os aliases ajuda em integrações externas.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_AQUI
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUA_CHAVE_SECRETA_AQUI
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_AQUI
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE_SECRETA_AQUI
SUPABASE_JWKS_URL=https://SEU_PROJETO.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# =====================================================
# WHATSAPP CLOUD API (Meta) — Preencha após configurar
# =====================================================
# Obtenha em: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_BUSINESS_ACCOUNT_ID=9876543210
WHATSAPP_VERIFY_TOKEN=balao_webhook_verify_2024
WHATSAPP_APP_SECRET=SUA_APP_SECRET_AQUI

# =====================================================
# APP
# =====================================================
NEXTAUTH_SECRET=gere_um_secret_aleatorio_aqui
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Balão CRM WhatsApp
